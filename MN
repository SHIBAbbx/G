-- 🔄 3. ระบบ Infinite Stamina (สตามิน่าไม่จำกัด)
-- ==========================================
RunService.Heartbeat:Connect(function()
    if not Settings.InfStamina.Enabled then return end

    local char = LocalPlayer.Character
    if not char then return end

    local staminaVal = char:FindFirstChild("Stamina") 
        or char:FindFirstChild("StaminaValue") 
        or char:FindFirstChild("Energy") 
        or LocalPlayer:FindFirstChild("Stamina")
        or LocalPlayer:FindFirstChild("StaminaValue")

    if staminaVal and (staminaVal:IsA("NumberValue") or staminaVal:IsA("IntValue")) then
        staminaVal.Value = Settings.InfStamina.MaxStamina
    end

    if char:GetAttribute("Stamina") ~= nil then char:SetAttribute("Stamina", Settings.InfStamina.MaxStamina) end
    if char:GetAttribute("Energy") ~= nil then char:SetAttribute("Energy", Settings.InfStamina.MaxStamina) end
    if LocalPlayer:GetAttribute("Stamina") ~= nil then LocalPlayer:SetAttribute("Stamina", Settings.InfStamina.MaxStamina) end
end)

