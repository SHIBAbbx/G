-- 🔄 Anti-Void System
local lastSafeCFrame = nil
trackConnection(RunService.Heartbeat:Connect(function()
    if not Settings.AntiVoid.Enabled then return end
    local character = LocalPlayer.Character
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChild("Humanoid")

    if root and humanoid and humanoid.Health > 0 then
        local currentY = root.Position.Y
        if currentY > (Settings.AntiVoid.VoidYLimit + 20) and humanoid.FloorMaterial ~= Enum.Material.Air then
            lastSafeCFrame = root.CFrame
        end

        if currentY <= Settings.AntiVoid.VoidYLimit then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            if Settings.AntiVoid.UseTeleportBack and lastSafeCFrame then
                root.CFrame = lastSafeCFrame + Vector3.new(0, 3, 0)
            else
                root.AssemblyLinearVelocity = Vector3.new(0, Settings.AntiVoid.BounceForce, 0)
            end
        end
    end
end))

-- 🔄 Infinite Stamina System
trackConnection(RunService.Heartbeat:Connect(function()
    if not Settings.InfStamina.Enabled then return end
    local char = LocalPlayer.Character
    if not char then return end

    local staminaVal = char:FindFirstChild("Stamina") or char:FindFirstChild("StaminaValue") or LocalPlayer:FindFirstChild("Stamina")
    if staminaVal and (staminaVal:IsA("NumberValue") or staminaVal:IsA("IntValue")) then
        staminaVal.Value = Settings.InfStamina.MaxStamina
    end

    if char:GetAttribute("Stamina") ~= nil then char:SetAttribute("Stamina", Settings.InfStamina.MaxStamina) end
end))

-- 🔄 Dynamic Overhead ESP System
local ESPCache = {}

local function cleanupESP(player)
    if ESPCache[player] then
        local data = ESPCache[player]
        if data.Highlight then pcall(function() data.Highlight:Destroy() end) end
        if data.Billboard then pcall(function() data.Billboard:Destroy() end) end
        ESPCache[player] = nil
    end
end

