local ESPCache = {}

local function createESPBar(player, character)
    if player == LocalPlayer then return end

    local head = character:WaitForChild("Head", 5)
    local humanoid = character:WaitForChild("Humanoid", 5)
    if not head or not humanoid then return end

    if head:FindFirstChild("StatusESP_Bar") then head.StatusESP_Bar:Destroy() end
    if character:FindFirstChild("StatusESP_Highlight") then character.StatusESP_Highlight:Destroy() end

    local highlight = Instance.new("Highlight")
    highlight.Name = "StatusESP_Highlight"
    highlight.Adornee = character
    highlight.FillColor = Color3.fromRGB(46, 204, 113)
    highlight.FillTransparency = 0.6
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "StatusESP_Bar"
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 140, 0, 65)
    billboard.StudsOffset = Vector3.new(0, 3.2, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = head

    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 1, 0)
    container.BackgroundTransparency = 1
    container.Parent = billboard

    local nameLabel = Instance.new("TextLabel")
