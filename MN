-- 🔄 5. ระบบ Anti-Blur
-- ==========================================
local function removeBlurEffects()
    for _, v in ipairs(Lighting:GetDescendants()) do
        if v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") then v:Destroy() end
    end
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") then v:Destroy() end
    end
end

Lighting.DescendantAdded:Connect(function(child)
    if Settings.AntiBlur.Enabled and (child:IsA("BlurEffect") or child:IsA("DepthOfFieldEffect")) then
        task.wait()
        child:Destroy()
    end
end)

Workspace.DescendantAdded:Connect(function(child)
    if Settings.AntiBlur.Enabled and (child:IsA("BlurEffect") or child:IsA("DepthOfFieldEffect")) then
        task.wait()
        child:Destroy()
    end
end)

-- ฟังก์ชันดึงรายชื่อผู้เล่นเพื่ออัปเดต Dropdown
local function getPlayerNames()
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(names, p.Name)
        end
    end
    if #names == 0 then table.insert(names, "No Players") end
    return names
end

local function refreshPlayerDropdown()
    if PlayerDropdown then
        PlayerDropdown:Refresh(getPlayerNames())
    end
end

Players.PlayerAdded:Connect(refreshPlayerDropdown)
Players.PlayerRemoving:Connect(refreshPlayerDropdown)

-- ฟังก์ชันวาร์ปกลางไปตำแหน่งที่บันทึก
local function teleportToSaved()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        if savedCFrame then
            root.CFrame = savedCFrame
            Rayfield:Notify({
                Title = "Teleported!",
                Content = "วาร์ปไปยังตำแหน่งที่บันทึกไว้เรียบร้อยแล้ว",
                Duration = 2,
                Image = 4483362458,
            })
        else
            Rayfield:Notify({
                Title = "Warning",
                Content = "คุณยังไม่ได้บันทึกตำแหน่ง!",
                Duration = 2,
                Image = 4483362458,
            })
        end
    end
end

