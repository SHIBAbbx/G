-- 🔄 5. Anti-Blur System
-- ==========================================
local function clearBlur(child)
    if Settings.AntiBlur.Enabled and (child:IsA("BlurEffect") or child:IsA("DepthOfFieldEffect")) then
        task.defer(function() child:Destroy() end)
    end
end
Lighting.DescendantAdded:Connect(clearBlur)
Workspace.DescendantAdded:Connect(clearBlur)

local function getPlayerNames()
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then table.insert(names, p.Name) end end
    return #names > 0 and names or {"No Players"}
end
local function refreshDropdown()
    if PlayerDropdown then PlayerDropdown:Refresh(getPlayerNames()) end
end
Players.PlayerAdded:Connect(refreshDropdown)
Players.PlayerRemoving:Connect(refreshDropdown)

local function teleportToSaved()
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root and savedCFrame then
        root.CFrame = savedCFrame
        Rayfield:Notify({Title = "Teleported!", Content = "วาร์ปเรียบร้อย", Duration = 2})
    else
        Rayfield:Notify({Title = "Error", Content = "ยังไม่ได้บันทึกจุด / ไม่พบตัวละคร", Duration = 2})
    end
end

