-- ==========================================
-- 🛠️ Helper Functions & Caching
-- ==========================================
local function make(cls, parent, props)
    local obj = Instance.new(cls)
    for k, v in pairs(props or {}) do obj[k] = v end
    obj.Parent = parent
    return obj
end

local function getHealthColor(percent)
    if percent >= 0.5 then
        return Color3.fromRGB(241, 196, 15):Lerp(Color3.fromRGB(46, 204, 113), (percent - 0.5) * 2)
    else
        return Color3.fromRGB(231, 76, 60):Lerp(Color3.fromRGB(241, 196, 15), percent * 2)
    end
end

-- ระบบเช็คเพื่อนแบบลดอาการแลค (Async Friend Caching)
local FriendCache = {}
local function isFriend(player)
    if FriendCache[player] == nil then
        FriendCache[player] = false -- ตั้งค่าเริ่มต้นกันบั๊ก
        task.spawn(function()
            pcall(function()
                FriendCache[player] = LocalPlayer:IsFriendsWith(player.UserId)
            end)
        end)
    end
    return FriendCache[player]
end

Players.PlayerRemoving:Connect(function(player)
    FriendCache[player] = nil -- ลบความจำเมื่อผู้เล่นออก
end)

