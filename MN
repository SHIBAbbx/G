-- ==========================================
-- 🔄 2. Anti-Void & Inf Stamina
-- ==========================================
local lastSafeCFrame = nil
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local root, hum = char:FindFirstChild("HumanoidRootPart"), char:FindFirstChild("Humanoid")

    if Settings.AntiVoid.Enabled and root and hum and hum.Health > 0 then
        local y = root.Position.Y
        if y > (Settings.AntiVoid.VoidYLimit + 20) and hum.FloorMaterial ~= Enum.Material.Air then lastSafeCFrame = root.CFrame end
        if y <= Settings.AntiVoid.VoidYLimit then
            root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
            if Settings.AntiVoid.UseTeleportBack and lastSafeCFrame then root.CFrame = lastSafeCFrame + Vector3.new(0, 3, 0)
            else root.AssemblyLinearVelocity = Vector3.new(0, Settings.AntiVoid.BounceForce, 0) end
        end
    end

    if Settings.InfStamina.Enabled then
        local st = char:FindFirstChild("Stamina") or char:FindFirstChild("StaminaValue") or char:FindFirstChild("Energy") or LocalPlayer:FindFirstChild("Stamina")
        if st and (st:IsA("NumberValue") or st:IsA("IntValue")) then st.Value = Settings.InfStamina.MaxStamina end
        for _, obj in ipairs({char, LocalPlayer}) do
            if obj:GetAttribute("Stamina") then obj:SetAttribute("Stamina", Settings.InfStamina.MaxStamina) end
            if obj:GetAttribute("Energy") then obj:SetAttribute("Energy", Settings.InfStamina.MaxStamina) end
        end
    end
end)

-- ==========================================
-- 🔄 3. Player ESP & Overhead UI Setup
-- ==========================================
local ESPCache = {}

local function cleanupESP(player)
    if ESPCache[player] then
        pcall(function() ESPCache[player].Highlight:Destroy() end)
        pcall(function() ESPCache[player].Billboard:Destroy() end)
        ESPCache[player] = nil
    end
end

local function setupESP(player, char)
    cleanupESP(player)
    local part, hum = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"), char:FindFirstChild("Humanoid")
    if not part or not hum then return end

    local hl = make("Highlight", char, {Name = "ESP_HL", Adornee = char, FillColor = Settings.ESP.FillColor, FillTransparency = 0.6, OutlineColor = Settings.ESP.OutlineColor, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop})
    local bb = make("BillboardGui", part, {Name = "ESP_BB", Adornee = part, Size = UDim2.new(0, 140, 0, 40), StudsOffset = Vector3.new(0, 3.2, 0), AlwaysOnTop = true})
    local con = make("Frame", bb, {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1})
    
    local nameTxt = make("TextLabel", con, {Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Text = player.DisplayName, TextColor3 = Color3.fromRGB(255, 255, 255), TextStrokeTransparency = 0.2, TextStrokeColor3 = Color3.fromRGB(0, 0, 0), Font = Enum.Font.GothamBold, TextSize = 13})
    
    local hpBg = make("Frame", con, {Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 0, 20), BackgroundColor3 = Color3.fromRGB(30, 30, 30), BorderSizePixel = 0})
    make("UICorner", hpBg, {CornerRadius = UDim.new(0, 4)})
    make("UIStroke", hpBg, {Color = Color3.fromRGB(0, 0, 0), Thickness = 1.2})
    local hpFill = make("Frame", hpBg, {Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(46, 204, 113), BorderSizePixel = 0})
    make("UICorner", hpFill, {CornerRadius = UDim.new(0, 4)})
    local hpTxt = make("TextLabel", hpBg, {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "HP: 100/100", TextColor3 = Color3.fromRGB(255, 255, 255), TextStrokeTransparency = 0.3, TextStrokeColor3 = Color3.fromRGB(0, 0, 0), Font = Enum.Font.GothamBold, TextSize = 11})

    ESPCache[player] = {Character = char, Humanoid = hum, Highlight = hl, Billboard = bb, NameText = nameTxt, HpFill = hpFill, HpText = hpTxt}
end

Players.PlayerRemoving:Connect(cleanupESP)

-- 🔄 4. Throttled Main Loop
task.spawn(function()
    while task.wait(0.05) do
        local myChar = LocalPlayer.Character
        local myHum = myChar and myChar:FindFirstChild("Humanoid")
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

        -- Update Self HUD
        if Settings.LocalHUD.Enabled and myChar and myHum and myHum.Health > 0 then
            myHudFrame.Visible = true
            local myHpPercent = math.clamp(myHum.Health / myHum.MaxHealth, 0, 1)
            myHpFill.Size = UDim2.new(myHpPercent, 0, 1, 0)
            myHpFill.BackgroundColor3 = getHealthColor(myHpPercent)
            myHpText.Text = string.format("❤️ HP: %d / %d", math.floor(myHum.Health), math.floor(myHum.MaxHealth))
            
            local stVal = myChar:GetAttribute("Stamina") or 0
            myStFill.Size = UDim2.new(math.clamp(stVal / Settings.InfStamina.MaxStamina, 0, 1), 0, 1, 0)
            myStText.Text = string.format("⚡ STAMINA: %d", math.floor(stVal))
        else
            myHudFrame.Visible = false
        end

        -- Update ESP Players (พร้อมระบบแยกเพื่อน)
        if Settings.ESP.Enabled then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local char = player.Character
                    local hum = char and char:FindFirstChild("Humanoid")
                    local root = char and char:FindFirstChild("HumanoidRootPart")

                    if char and char.Parent and hum and hum.Health > 0 and root then
                        local cache = ESPCache[player]
                        if not cache or cache.Character ~= char then setupESP(player, char); cache = ESPCache[player] end
                        
                        if cache then
                            local dist = myRoot and (myRoot.Position - root.Position).Magnitude or 0
                            if dist <= Settings.ESP.MaxDistance then
                                cache.Billboard.Enabled, cache.Highlight.Enabled = true, true
                                
                                -- ⭐️ ระบบแยกสีเพื่อน
                                local isFr = isFriend(player)
                                local targetColor = isFr and Settings.ESP.FriendColor or Settings.ESP.FillColor
                                
                                cache.Highlight.FillColor = targetColor
                                cache.NameText.TextColor3 = isFr and targetColor or Color3.fromRGB(255, 255, 255)
                                
                                -- ใส่รูปดาว ⭐️ หน้าชื่อถ้าเป็นเพื่อน
                                local prefix = isFr and "⭐️ " or ""
                                cache.NameText.Text = string.format("%s%s [%dm]", prefix, player.DisplayName, math.floor(dist))
                                
                                -- อัปเดตเลือด
                                local hpPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                                cache.HpFill.Size = UDim2.new(hpPercent, 0, 1, 0)
                                cache.HpFill.BackgroundColor3 = getHealthColor(hpPercent)
                                cache.HpText.Text = string.format("HP: %d/%d", math.floor(hum.Health), math.floor(hum.MaxHealth))
                            else
                                cache.Billboard.Enabled, cache.Highlight.Enabled = false, false
                            end
                        end
                    else
                        cleanupESP(player)
                    end
                end
            end
        else
            for p in pairs(ESPCache) do cleanupESP(p) end
        end
    end
end)

-- Fast Spectate Loop
RunService.RenderStepped:Connect(function()
    if Spectating then
        local cam = Workspace.CurrentCamera
        local target = SelectedPlayerName and Players:FindFirstChild(SelectedPlayerName)
        local hum = target and target.Character and target.Character:FindFirstChild("Humanoid")
