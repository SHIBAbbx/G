-- Helper Functions
local function removeBlurEffects()
    for _, v in ipairs(Lighting:GetDescendants()) do
        if v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") then v:Destroy() end
    end
end

function getTargetPlayer()
    if TargetInputName ~= "" then
        local searchStr = string.lower(TargetInputName)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                if string.find(string.lower(p.Name), searchStr) or string.find(string.lower(p.DisplayName), searchStr) then
                    return p
                end
            end
        end
    end
    if SelectedPlayerName and SelectedPlayerName ~= "No Players" then
        return Players:FindFirstChild(SelectedPlayerName)
    end
    return nil
end

local function getPlayerNames()
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then table.insert(names, p.Name) end
    end
    if #names == 0 then table.insert(names, "No Players") end
    return names
end

local function refreshPlayerDropdown()
    if PlayerDropdown then PlayerDropdown:SetValues(getPlayerNames()) end
end

trackConnection(Players.PlayerAdded:Connect(refreshPlayerDropdown))
