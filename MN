-- 🔄 5. ระบบ Anti-Blur (ลบเอฟเฟกต์เบลอ)
-- ==========================================
local function removeBlurEffects()
    for _, v in ipairs(Lighting:GetDescendants()) do
        if v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") then v:Destroy() end
    end
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") then v:Destroy() end
    end
end

Lighting.DescendantAdded:Connect(function(child)
    if Settings.AntiBlur.Enabled and (child:IsA("BlurEffect") or child:IsA("DepthOfFieldEffect")) then
        task.wait()
        child:Destroy()
    end
end)

Workspace.DescendantAdded:Connect(function(child)
    if Settings.AntiBlur.Enabled and (child:IsA("BlurEffect") or child:IsA("DepthOfFieldEffect")) then
        task.wait()
        child:Destroy()
    end
end)

