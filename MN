local function teleportToSaved()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        if savedCFrame then
            root.CFrame = savedCFrame
            Fluent:Notify({ Title = "Teleported!", Content = "วาร์ปเรียบร้อยแล้ว", Duration = 3 })
        else
            Fluent:Notify({ Title = "Warning", Content = "ยังไม่ได้บันทึกตำแหน่ง!", Duration = 3 })
        end
    end
end

