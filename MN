-- 🔄 3. Player ESP & Logic Loops[cite: 1]
-- ==========================================
local ESPCache = {}
local function cleanupESP(player)
    if ESPCache[player] then pcall(function() ESPCache[player].Highlight:Destroy(); ESPCache[player].Billboard:Destroy() end); ESPCache[player] = nil end
end
local function setupESP(player, char)
    cleanupESP(player)
    local part, hum = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"), char:FindFirstChild("Humanoid")
    if not part or not hum then return end
    local hl = make("Highlight", char, {Name = "ESP_HL", Adornee = char, FillColor = Settings.ESP.FillColor, FillTransparency = 0.6, OutlineColor = Settings.ESP.OutlineColor, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop})
    local bb = make("BillboardGui", part, {Name = "ESP_BB", Adornee = part, Size = UDim2.new(0, 140, 0, 65), StudsOffset = Vector3.new(0, 3.2, 0), AlwaysOnTop = true})
    local con = make("Frame", bb, {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1})
    make("TextLabel", con, {Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Text = player.DisplayName, TextColor3 = Color3.fromRGB(255, 255, 255), TextStrokeTransparency = 0, Font = Enum.Font.SourceSansBold, TextSize = 13})
    local hpBg = make("Frame", con, {Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 0, 20), BackgroundColor3 = Color3.fromRGB(40, 40, 40), BorderSizePixel = 0}); make("UICorner", hpBg, {CornerRadius = UDim.new(0, 4)})
    local hpFill = make("Frame", hpBg, {Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(46, 204, 113), BorderSizePixel = 0}); make("UICorner", hpFill, {CornerRadius = UDim.new(0, 4)})
    local hpTxt = make("TextLabel", hpBg, {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "HP: 100/100", TextColor3 = Color3.fromRGB(255, 255, 255), TextStrokeTransparency = 0.5, Font = Enum.Font.SourceSansBold, TextSize = 11})
    ESPCache[player] = {Character = char, Humanoid = hum, Highlight = hl, Billboard = bb, HpFill = hpFill, HpText = hpTxt}
end
Players.PlayerRemoving:Connect(cleanupESP)

task.spawn(function()
    while task.wait(0.05) do
        local myChar = LocalPlayer.Character
        local myHum, myRoot = myChar and myChar:FindFirstChild("Humanoid"), myChar and myChar:FindFirstChild("HumanoidRootPart")

        -- Self HUD
        if Settings.LocalHUD.Enabled and myChar and myHum and myHum.Health > 0 then
            myHudFrame.Visible = true
            myHpFill.Size = UDim2.new(math.clamp(myHum.Health / myHum.MaxHealth, 0, 1), 0, 1, 0)
            myHpText.Text = string.format("❤️ HP: %d / %d", math.floor(myHum.Health), math.floor(myHum.MaxHealth))
            local stVal = myChar:GetAttribute("Stamina") or 0
            myStFill.Size = UDim2.new(math.clamp(stVal / Settings.ESP.MaxStamina, 0, 1), 0, 1, 0)
            myStText.Text = string.format("⚡ STAMINA: %d / %d", math.floor(stVal), Settings.ESP.MaxStamina)
        else
            myHudFrame.Visible = false
        end

        -- ESP
        if Settings.ESP.Enabled then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local char = player.Character
                    local hum = char and char:FindFirstChild("Humanoid")
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    if char and char.Parent and hum and hum.Health > 0 and root then
                        local cache = ESPCache[player]
                        if not cache or cache.Character ~= char then setupESP(player, char); cache = ESPCache[player] end
                        if cache then
                            local dist = myRoot and (myRoot.Position - root.Position).Magnitude or 0
                            if dist <= Settings.ESP.MaxDistance then
                                cache.Billboard.Enabled, cache.Highlight.Enabled = true, true
                                cache.HpFill.Size = UDim2.new(math.clamp(hum.Health / hum.MaxHealth, 0, 1), 0, 1, 0)
                                cache.HpText.Text = string.format("HP: %d/%d", math.floor(hum.Health), math.floor(hum.MaxHealth))
                            else
                                cache.Billboard.Enabled, cache.Highlight.Enabled = false, false
                            end
                        end
                    else cleanupESP(player) end
                end
            end
        else for p in pairs(ESPCache) do cleanupESP(p) end end
    end
end)

-- Anti Void & Stamina
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local root, hum = char:FindFirstChild("HumanoidRootPart"), char:FindFirstChild("Humanoid")
    if Settings.AntiVoid.Enabled and root and hum and hum.Health > 0 then
        local y = root.Position.Y
        if y > (Settings.AntiVoid.VoidYLimit + 20) and hum.FloorMaterial ~= Enum.Material.Air then lastSafeCFrame = root.CFrame end
        if y <= Settings.AntiVoid.VoidYLimit then
            root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
            if Settings.AntiVoid.UseTeleportBack and lastSafeCFrame then root.CFrame = lastSafeCFrame + Vector3.new(0, 3, 0)
            else root.AssemblyLinearVelocity = Vector3.new(0, Settings.AntiVoid.BounceForce, 0) end
        end
    end
    if Settings.InfStamina.Enabled then
        local st = char:FindFirstChild("Stamina") or char:FindFirstChild("StaminaValue")
        if st then st.Value = Settings.InfStamina.MaxStamina end
        if char:GetAttribute("Stamina") then char:SetAttribute("Stamina", Settings.InfStamina.MaxStamina) end
    end
end)

-- Spectate & Utility
RunService.RenderStepped:Connect(function()
    if Spectating then
        local cam = Workspace.CurrentCamera
        local target = SelectedPlayerName and Players:FindFirstChild(SelectedPlayerName)
        local hum = target and target.Character and target.Character:FindFirstChild("Humanoid")
        if hum and hum.Health > 0 then cam.CameraSubject = hum
        else local myHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid"); if myHum then cam.CameraSubject = myHum end end
    end
end)

local function clearBlur(child)
    if Settings.AntiBlur.Enabled and (child:IsA("BlurEffect") or child:IsA("DepthOfFieldEffect")) then task.defer(function() child:Destroy() end) end
end
Lighting.DescendantAdded:Connect(clearBlur); Workspace.DescendantAdded:Connect(clearBlur)

