    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.DisplayName
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextStrokeTransparency = 0
    nameLabel.Font = Enum.Font.SourceSansBold
    nameLabel.TextSize = 13
    nameLabel.Parent = container

    local hpBg = Instance.new("Frame")
    hpBg.Size = UDim2.new(1, 0, 0, 14)
    hpBg.Position = UDim2.new(0, 0, 0, 20)
    hpBg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    hpBg.BorderSizePixel = 0
    hpBg.Parent = container
    Instance.new("UICorner", hpBg).CornerRadius = UDim.new(0, 4)

    local hpFill = Instance.new("Frame")
    hpFill.Size = UDim2.new(1, 0, 1, 0)
    hpFill.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
    hpFill.BorderSizePixel = 0
    hpFill.Parent = hpBg
    Instance.new("UICorner", hpFill).CornerRadius = UDim.new(0, 4)

    local hpText = Instance.new("TextLabel")
    hpText.Size = UDim2.new(1, 0, 1, 0)
    hpText.BackgroundTransparency = 1
    hpText.Text = "HP: 100/100"
    hpText.TextColor3 = Color3.fromRGB(255, 255, 255)
    hpText.TextStrokeTransparency = 0.5
    hpText.Font = Enum.Font.SourceSansBold
    hpText.TextSize = 11
    hpText.Parent = hpBg

    local stBg = Instance.new("Frame")
    stBg.Size = UDim2.new(1, 0, 0, 14)
    stBg.Position = UDim2.new(0, 0, 0, 38)
    stBg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    stBg.BorderSizePixel = 0
    stBg.Parent = container
    Instance.new("UICorner", stBg).CornerRadius = UDim.new(0, 4)

    local stFill = Instance.new("Frame")
    stFill.Size = UDim2.new(1, 0, 1, 0)
    stFill.BackgroundColor3 = Color3.fromRGB(241, 196, 15)
    stFill.BorderSizePixel = 0
    stFill.Parent = stBg
    Instance.new("UICorner", stFill).CornerRadius = UDim.new(0, 4)

    local stText = Instance.new("TextLabel")
    stText.Size = UDim2.new(1, 0, 1, 0)
    stText.BackgroundTransparency = 1
    stText.Text = "ST: 100"
    stText.TextColor3 = Color3.fromRGB(255, 255, 255)
    stText.TextStrokeTransparency = 0.5
    stText.Font = Enum.Font.SourceSansBold
    stText.TextSize = 11
    stText.Parent = stBg

    ESPCache[player] = {
        Character = character,
        Humanoid = humanoid,
        Highlight = highlight,
        Billboard = billboard,
        HpFill = hpFill,
        HpText = hpText,
        StFill = stFill,
        StText = stText
    }
end

RunService.RenderStepped:Connect(function()
    -- 4.1 อัปเดต HUD ของตัวเราเอง
    if Settings.LocalHUD.Enabled then
        local myChar = LocalPlayer.Character
        if myChar then
            local myHum = myChar:FindFirstChild("Humanoid")
            if myHum and myHum.Health > 0 then
                myHudFrame.Visible = true
                
                local hpPct = math.clamp(myHum.Health / myHum.MaxHealth, 0, 1)
                myHpFill.Size = UDim2.new(hpPct, 0, 1, 0)
                myHpText.Text = string.format("❤️ HP: %d / %d", math.floor(myHum.Health), math.floor(myHum.MaxHealth))

                local stVal = myChar:GetAttribute("Stamina") or 0
                local stPct = math.clamp(stVal / Settings.ESP.MaxStamina, 0, 1)
                myStFill.Size = UDim2.new(stPct, 0, 1, 0)
                myStText.Text = string.format("⚡ STAMINA: %d / %d", math.floor(stVal), Settings.ESP.MaxStamina)
            else
                myHudFrame.Visible = false
            end
        else
            myHudFrame.Visible = false
        end
    else
        myHudFrame.Visible = false
    end

    -- 4.2 อัปเดต ESP บนหัวคนอื่น
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for player, data in pairs(ESPCache) do
        if data.Character and data.Character.Parent and data.Humanoid and data.Humanoid.Health > 0 then
            local targetRoot = data.Character:FindFirstChild("HumanoidRootPart")
            if myRoot and targetRoot and Settings.ESP.Enabled then
                local distance = (myRoot.Position - targetRoot.Position).Magnitude
                if distance <= Settings.ESP.MaxDistance then
                    data.Billboard.Enabled = true
                    data.Highlight.Enabled = true

                    local hpPct = math.clamp(data.Humanoid.Health / data.Humanoid.MaxHealth, 0, 1)
                    data.HpFill.Size = UDim2.new(hpPct, 0, 1, 0)
                    data.HpText.Text = string.format("HP: %d/%d", math.floor(data.Humanoid.Health), math.floor(data.Humanoid.MaxHealth))

                    local staminaVal = data.Character:GetAttribute("Stamina") or 0
                    local stPct = math.clamp(staminaVal / Settings.ESP.MaxStamina, 0, 1)
                    data.StFill.Size = UDim2.new(stPct, 0, 1, 0)
                    data.StText.Text = string.format("ST: %d [%dm]", math.floor(staminaVal), math.floor(distance))
                else
                    data.Billboard.Enabled = false
                    data.Highlight.Enabled = false
                end
            else
                data.Billboard.Enabled = false
                data.Highlight.Enabled = false
            end
        else
            if data.Billboard then data.Billboard:Destroy() end
            if data.Highlight then data.Highlight:Destroy() end
            ESPCache[player] = nil
        end
    end
end)

local function onPlayerAdded(player)
    player.CharacterAdded:Connect(function(character)
        createESPBar(player, character)
    end)
    if player.Character then
        createESPBar(player, player.Character)
    end
end

for _, p in ipairs(Players:GetPlayers()) do onPlayerAdded(p) end
Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(function(p) ESPCache[p] = nil end)

