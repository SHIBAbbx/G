-- 🛠️ Helper Function สร้าง Instance
local function make(cls, parent, props)
    local obj = Instance.new(cls)
    for k, v in pairs(props or {}) do obj[k] = v end
    obj.Parent = parent
    return obj
end

-- ==========================================
-- ⚔️ 1. Auto Block / Parry (Event-Based VIM)
-- ==========================================
local isBlocking = false
local function performBlock()
    if isBlocking then return end
    isBlocking = true
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
    task.wait(Settings.Combat.HoldTime)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
    task.wait(0.1)
    isBlocking = false
end

local function attachSensorToEnemy(enemyPlayer)
    local function setupAnimator(char)
        local hum = char:WaitForChild("Humanoid", 5)
        if hum then
            local animator = hum:WaitForChild("Animator", 5)
            if animator then
                animator.AnimationPlayed:Connect(function(track)
                    if not Settings.Combat.AutoBlock then return end
                    local myChar = LocalPlayer.Character
                    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    local enemyRoot = char:FindFirstChild("HumanoidRootPart")
                    
                    if myRoot and enemyRoot then
                        local dist = (myRoot.Position - enemyRoot.Position).Magnitude
                        if dist <= Settings.Combat.BlockRange then
                            task.spawn(performBlock)
                        end
                    end
                end)
            end
        end
    end

    enemyPlayer.CharacterAdded:Connect(setupAnimator)
    if enemyPlayer.Character then setupAnimator(enemyPlayer.Character) end
end

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then attachSensorToEnemy(player) end
end
Players.PlayerAdded:Connect(function(player) attachSensorToEnemy(player) end)

